%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial, sans-serif", "primaryColor": "#f8fafc", "primaryBorderColor": "#334155", "lineColor": "#475569", "tertiaryColor": "#f8fafc"}}}%%
flowchart TB
  QrSession["Quét QR<br/>xác minh tenant/bàn, tạo hoặc join session/cart"]
  Submit["Submit order<br/>PENDING + idempotency key"]
  StaffConfirm["Staff xác nhận<br/>kiểm tra và trừ stock tại thời điểm xác nhận"]
  Kds["KDS theo station<br/>Chef/Barista xử lý, staff phục vụ món"]
  Bill["Request bill<br/>cart rỗng, order đã served, bàn Billing"]
  Payment["Thanh toán bill<br/>Cash hoặc VietQR/SePay"]
  Paid["Bill PAID<br/>đóng session và cart"]
  Cleaning["Dọn bàn<br/>staff đánh dấu sạch, bàn Available"]

  Blocked["Billing/Cleaning<br/>chặn gọi món mới"]
  Rejected["Reject/cancel PENDING<br/>không trừ stock"]
  Underpaid["Webhook thiếu tiền hoặc trùng<br/>xử lý idempotent, không đóng bill sai"]

  QrSession --> Submit
  QrSession -.-> Blocked
  Submit --> StaffConfirm
  StaffConfirm -->|"Không xác nhận"| Rejected
  StaffConfirm -->|"Xác nhận"| Kds
  Kds --> Bill
  Bill --> Payment
  Payment -->|"Thiếu hoặc lặp"| Underpaid
  Underpaid -.-> Payment
  Payment -->|"Đủ tiền / cash đã xác nhận"| Paid
  Paid --> Cleaning

  classDef entry fill:#dbeafe,stroke:#2563eb,color:#111827;
  classDef decision fill:#fef3c7,stroke:#d97706,color:#111827;
  classDef order fill:#dcfce7,stroke:#16a34a,color:#111827;
  classDef kitchen fill:#ecfdf5,stroke:#059669,color:#111827;
  classDef payment fill:#fdf2f8,stroke:#db2777,color:#111827;
  classDef terminal fill:#f1f5f9,stroke:#64748b,color:#111827;
  classDef blocked fill:#fee2e2,stroke:#dc2626,color:#111827;

  class QrSession entry;
  class StaffConfirm decision;
  class Submit order; 
  class Kds kitchen;
  class Bill,Payment,Underpaid,Paid payment;
  class Cleaning terminal;
  class Blocked,Rejected blocked;
