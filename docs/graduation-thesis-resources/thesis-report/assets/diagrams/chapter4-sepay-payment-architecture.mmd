%%{init: {"theme": "base", "maxTextSize": 100000, "flowchart": {"htmlLabels": true, "curve": "basis"}, "themeVariables": {"fontFamily": "Arial, sans-serif", "primaryColor": "#f8fafc", "primaryBorderColor": "#cbd5e1", "lineColor": "#475569", "tertiaryColor": "#ffffff"}}}%%
flowchart TB
  subgraph BillLane["Dòng tiền hóa đơn nhà hàng - QRTBL"]
    direction TB
    Customer["Khách / POS<br/>yêu cầu thanh toán hóa đơn"]
    BillBff["BFF<br/>điều phối yêu cầu thanh toán"]
    Order["Order<br/>trạng thái hóa đơn và phiên"]
    Payment["Payment<br/>tạo tham chiếu QRTBL<br/>sở hữu giao dịch, cấu hình, kiểm toán"]
    SepayBill["SePay / VietQR<br/>webhook QRTBL"]
    PaymentSettle["Payment<br/>ghi nhận lũy đẳng và kiểm toán"]
    OrderPaid["Order<br/>đánh dấu hóa đơn đã thanh toán"]
    Kafka@{ icon: "logos:kafka-icon", form: "rounded", label: "Kafka - payment.completed", pos: "t", h: 58 }
  end

  subgraph SubscriptionLane["Dòng tiền gói thuê bao nền tảng - QRSUB"]
    direction TB
    Owner["Chủ quán / Quản trị viên<br/>mua hoặc gia hạn gói"]
    SubBff["BFF<br/>điều phối thanh toán gói"]
    SaasInvoice["SaaS<br/>tạo hóa đơn gói"]
    SepaySub["SePay / VietQR<br/>webhook QRSUB"]
    SaasSettle["SaaS<br/>ghi nhận hóa đơn gói lũy đẳng"]
    Entitlement["Gói thuê bao<br/>cập nhật quyền theo gói"]
  end

  Customer --> BillBff
  BillBff -->|"lấy trạng thái hóa đơn"| Order
  BillBff -->|"tạo giao dịch"| Payment
  Payment -->|"VietQR QRTBL"| SepayBill
  SepayBill -->|"webhook qua BFF"| PaymentSettle
  PaymentSettle --> OrderPaid
  PaymentSettle --> Kafka

  Owner --> SubBff
  SubBff --> SaasInvoice
  SaasInvoice -->|"VietQR QRSUB"| SepaySub
  SepaySub -->|"webhook qua BFF"| SaasSettle
  SaasSettle --> Entitlement

  Boundary["Ranh giới trách nhiệm<br/>Payment không sở hữu gói thuê bao.<br/>SaaS không sở hữu hóa đơn nhà hàng.<br/>BFF xác thực và định tuyến webhook."]
  PaymentSettle --> Boundary
  SaasSettle --> Boundary

  classDef actor fill:#eff6ff,stroke:#2563eb,color:#0f172a;
  classDef edge fill:#fff7ed,stroke:#ea580c,color:#0f172a;
  classDef payment fill:#f0fdf4,stroke:#16a34a,color:#0f172a;
  classDef provider fill:#fee2e2,stroke:#dc2626,color:#0f172a;
  classDef event fill:#f5f3ff,stroke:#7c3aed,color:#0f172a;
  classDef note fill:#f8fafc,stroke:#64748b,color:#0f172a;

  class Customer,Owner actor;
  class BillBff,SubBff edge;
  class Order,Payment,PaymentSettle,OrderPaid,SaasInvoice,SaasSettle,Entitlement payment;
  class SepayBill,SepaySub provider;
  class Kafka event;
  class Boundary note;
