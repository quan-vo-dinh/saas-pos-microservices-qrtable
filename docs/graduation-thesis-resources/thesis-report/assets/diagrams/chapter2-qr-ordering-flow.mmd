%% MAP: chapter2-qr-ordering-flow.excalidraw | Hình 2.2 | §2.2
%% ICON: scan-qr.svg, redis.svg (phiên / nhớ tạm)
%% Preview: mmdc -i chapter2-qr-ordering-flow.mmd -o preview-ch2-02.png -b transparent -w 1400
flowchart LR
  subgraph Story["Từ mã QR đến đơn vào bếp"]
    direction LR
    Q["Quét mã QR\ntại bàn"] --> R["Hệ thống xác định\nđúng nhà hàng & đúng bàn"]
    R --> P["Phiên gọi món tại bàn\n(mọi khách cùng bàn dùng chung giỏ)"]
    P --> M["Xem thực đơn & chọn món"]
    M --> S["Gửi yêu cầu\nvào quy trình POS"]
    S --> K["Bếp / nhân viên\nnhận order như bình thường"]
  end

  subgraph Meta["Mã QR chỉ là cửa vào"]
    N1["Không phải “menu treo tường”\nmà là vào hệ thống vận hành"]
  end

  Q -.-> N1

  subgraph Watch["Cần tránh (ở mức khái niệm)"]
    direction TB
    W1["Mã sai bàn / giả mạo"]
    W2["Khách bàn khác\nthấy chung dữ liệu"]
    W3["Bấm gửi nhiều lần\ntạo đơn trùng"]
  end

  R -.-> W1
  P -.-> W2
  S -.-> W3

  classDef watch fill:#fef2f2,stroke:#dc2626
  classDef meta fill:#f0fdf4,stroke:#16a34a,stroke-dasharray:4 4
  class W1,W2,W3 watch
  class N1 meta
