%%{init: {"theme": "base", "flowchart": {"htmlLabels": true, "curve": "basis"}, "themeVariables": {"fontFamily": "Arial, sans-serif", "primaryColor": "#f8fafc", "primaryBorderColor": "#cbd5e1", "lineColor": "#475569", "tertiaryColor": "#ffffff"}}}%%
flowchart TB
  Client["Ứng dụng người dùng<br/>Customer PWA, Management App"]
  BFF["BFF / API Gateway<br/>HTTP REST, WebSocket, guard chain<br/>TCP/gRPC clients"]
  Services["Dịch vụ miền nghiệp vụ<br/>Catalog, Order, Kitchen, Payment<br/>SaaS, User-Access, Authorizer"]
  Infra["PostgreSQL / MongoDB<br/>CSDL theo service"]
  Redis@{ icon: "logos:redis", form: "rounded", label: "Redis - cache, session, cart, KDS", pos: "t", h: 58 }
  Kafka@{ icon: "logos:kafka-icon", form: "rounded", label: "Kafka - approved domain events", pos: "t", h: 58 }
  Keycloak@{ icon: "simple-icons:keycloak", form: "rounded", label: "Keycloak - IAM nhân viên/quản trị", pos: "t", h: 58 }
  Sepay@{ img: "assets/diagrams/icons/sepay-placeholder.png", label: "SePay/VietQR - webhook QRTBL/QRSUB", pos: "t", h: 58, constraint: "on" }
  Cloudinary@{ icon: "logos:cloudinary-icon", form: "rounded", label: "Cloudinary - ảnh menu", pos: "t", h: 58 }

  Client -->|"HTTP REST"| BFF
  BFF -. "WebSocket hint/refetch" .-> Client
  BFF -->|"TCP RPC / gRPC"| Services
  Services -->|"ghi/đọc qua service sở hữu"| Infra
  Services -. "cache và trạng thái chạy" .-> Redis
  BFF -. "edge cache / socket rooms" .-> Redis
  Services -->|"domain events đã chấp nhận"| Kafka
  Kafka -->|"consumer / realtime bridge"| BFF
  Services -->|"verify JWT/OIDC"| Keycloak
  Sepay -->|"webhook qua BFF"| BFF
  Services -->|"provider API / OAuth"| Sepay
  Services -->|"upload/read image"| Cloudinary

  classDef client fill:#eff6ff,stroke:#2563eb,color:#0f172a;
  classDef edge fill:#fff7ed,stroke:#ea580c,color:#0f172a;
  classDef service fill:#f0fdf4,stroke:#16a34a,color:#0f172a;
  classDef infra fill:#f5f3ff,stroke:#7c3aed,color:#0f172a;
  classDef external fill:#fef2f2,stroke:#dc2626,color:#0f172a;
  classDef identityProvider fill:#f8fafc,stroke:#4b5563,stroke-width:1.2px,color:#4d4d4d;

  class Client client;
  class BFF edge;
  class Services service;
  class Infra,Redis,Kafka infra;
  class Keycloak identityProvider;
  class Sepay,Cloudinary external;
