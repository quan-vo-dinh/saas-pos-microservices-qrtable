%%{init: {"theme": "base", "sequence": {"showSequenceNumbers": true, "actorMargin": 90, "messageMargin": 48}, "themeVariables": {"fontFamily": "Arial, sans-serif", "primaryColor": "#eef6ff", "primaryBorderColor": "#2563eb", "actorBkg": "#f0fdf4", "actorBorder": "#16a34a", "noteBkgColor": "#fff7ed", "noteBorderColor": "#ea580c", "lineColor": "#475569"}}}%%
sequenceDiagram
  autonumber
  actor Customer as Customer<br/>PWA browser
  participant BFF as BFF<br/>API Gateway
  participant Order as Order<br/>Session + Cart
  participant Catalog as Catalog<br/>Table + Menu
  participant Redis as Redis<br/>session hash + cart
  participant ODB as PostgreSQL<br/>Order DB

  Customer->>BFF: Scan QR and open table session
  BFF->>BFF: Validate QR token/HMAC at edge
  BFF->>Order: TCP JOIN_SESSION(tenantId, tableId, token)
  Order->>Catalog: TCP VALIDATE_QR_TOKEN
  Catalog-->>Order: Table snapshot and current status

  alt Table is OCCUPIED with active session
    Order->>Redis: HGET session:{tenantId}:{sessionId}
    alt Redis hit and not idle
      Redis-->>Order: Active session hash
      Order->>Redis: PEXPIRE session/cart TTL
      Order-->>BFF: Existing active session
    else Redis miss or stale
      Order->>ODB: Find active session by tenant/table
      Order->>Redis: HSET session hash + PEXPIRE
      Order-->>BFF: Rehydrated active session
    end
  else Table is AVAILABLE
    Order->>ODB: Create ACTIVE session row
    Order->>Redis: HSET session hash + PEXPIRE
    Order->>Catalog: TCP UPDATE_TABLE_STATUS(OCCUPIED, sessionId)
    Catalog-->>Order: Updated table snapshot
    Order-->>BFF: New session
  else Idle empty session found
    Order->>ODB: Close only if orderCount = 0 and no currentBillId
    Order->>Redis: DEL stale session/cart
    Order->>Catalog: TCP UPDATE_TABLE_STATUS(AVAILABLE)
    Order->>ODB: Create replacement ACTIVE session
    Order->>Redis: HSET replacement session hash
  end

  BFF-->>Customer: Return session context and menu entry data
  Customer->>BFF: Add/update cart item with expectedCartVersion
  BFF->>Order: TCP CART_MUTATE
  Order->>Catalog: TCP VALIDATE_ORDERABLE(menuItemId, quantity)
  Catalog-->>Order: Menu item snapshot, price, station
  Order->>Redis: WATCH cart key + compare cartVersion
  Order->>Redis: HSET cart items, cartVersion++, PEXPIRE
  Order-->>BFF: CartUpdatedEvent
  BFF-->>Customer: Updated shared cart

  Customer->>BFF: Submit order(idempotencyKey, expectedCartVersion)
  BFF->>Order: TCP ORDER.SUBMIT
  Order->>Redis: Read cart snapshot and validate version
  Order->>ODB: Transaction: lock session, create Order PENDING, create/reuse Bill OPEN
  Order->>Redis: Clear cart if cartVersion still matches
  Order-->>BFF: OrderCreatedEvent + Bill + empty cart
  BFF-->>Customer: Order submitted, waiting for staff confirmation

  Note over BFF,Redis: WebSocket events in this flow are UI hints, Redis and DB state remain authoritative
