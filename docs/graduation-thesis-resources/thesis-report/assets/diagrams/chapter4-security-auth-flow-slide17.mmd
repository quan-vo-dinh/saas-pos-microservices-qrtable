    QR@{ icon: "mdi:qrcode", form: "rounded", label: "QR Code (Bàn / Tenant)", pos: "t", h: 50 }
    BFF_Cust@{ icon: "mdi:shield-check", form: "rounded", label: "BFF (SessionGuard)", pos: "t", h: 50 }
    Redis_Session@{ icon: "logos:redis", form: "rounded", label: "Redis Session", pos: "t", h: 50 }
    Domain_Cust@{ icon: "mdi:cart-outline", form: "rounded", label: "Catalog & Order", pos: "t", h: 50 }

    Customer -->|"1. Quét QR"| QR
    QR -->|"2. Vào PWA / Tạo Session"| BFF_Cust
    BFF_Cust -->|"3. Kiểm tra Session"| Redis_Session
    BFF_Cust -->|"4. Cho phép"| Domain_Cust
  end

  %% Highlight "Không dùng Keycloak"
  NoKeycloak@{ icon: "mdi:shield-off-outline", form: "rounded", label: "KHÔNG DÙNG KEYCLOAK<br/>(Tránh cản trở trải nghiệm khách)", pos: "t", h: 55 }
  BFF_Cust -.->|Không đi qua| NoKeycloak

