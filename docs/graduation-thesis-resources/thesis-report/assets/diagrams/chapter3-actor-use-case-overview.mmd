%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial, sans-serif", "primaryColor": "#ffffff", "primaryBorderColor": "#334155", "lineColor": "#475569", "tertiaryColor": "#ffffff"}, "flowchart": {"curve": "basis", "htmlLabels": true}}}%%
flowchart LR
  subgraph RBAC["Tác nhân — tài khoản & RBAC"]
    direction TB
    SuperAdmin["«tác nhân»<br/><b>Quản trị nền tảng</b><br/>(Super Admin)<br/>chéo tenant"]
    Owner["«tác nhân»<br/><b>Chủ nhà hàng</b><br/>(Owner)<br/>một tenant"]
    Manager["«tác nhân»<br/><b>Quản lý</b><br/>(Manager)<br/>một tenant"]
    Waiter["«tác nhân»<br/><b>Phục vụ / POS</b><br/>(Waiter)<br/>vận hành sàn"]
    KitchenStaff["«tác nhân»<br/><b>Bếp / pha chế</b><br/>(Chef / Barista)<br/>trạm bếp/bar"]
  end

  subgraph SYS["«hệ thống» QRTable"]
    direction TB
    UC_Platform(["Quản lý vòng đời SaaS<br/>tenant · gói · thuê bao · hạn mức"])
    UC_Reporting(["Bảng điều khiển và báo cáo<br/>report.read_own · report.read_any · analytics_basic"])
    UC_Catalog(["Quản lý thực đơn, bàn và QR<br/>thực đơn · khu vực · bàn · QR token"])
    UC_Pos(["Vận hành POS<br/>xác nhận đơn · hóa đơn · chuyển bàn · yêu cầu hỗ trợ"])
    UC_Kds(["Bếp / KDS<br/>hàng đợi theo trạm · phiếu · thu hồi · SLA"])
    UC_Payment(["Thanh toán và đối soát<br/>tiền mặt · VietQR/SePay · lịch sử"])
    UC_Ordering(["Phiên, giỏ và đơn của khách<br/>tham gia phiên · giỏ chung · gửi đơn"])
  end

  Customer["«tác nhân»<br/><b>Khách hàng</b><br/>phiên QR — không thuộc RBAC DB"]
  Sepay[["«hệ thống ngoài»<br/><b>Webhook SePay</b><br/>QRTBL · QRSUB"]]

  CrossCut["«ghi chú»<br/>Cô lập tenant<br/>RBAC · quyền sở hữu phiên"]

  SuperAdmin --> UC_Platform
  SuperAdmin --> UC_Reporting
  Owner --> UC_Platform
  Owner --> UC_Catalog
  Owner --> UC_Pos
  Owner --> UC_Kds
  Owner --> UC_Payment
  Owner --> UC_Reporting

  Manager -->|"xem thuê bao/cài đặt"| UC_Platform
  Manager --> UC_Catalog
  Manager --> UC_Pos
  Manager --> UC_Kds
  Manager --> UC_Payment
  Manager --> UC_Reporting

  Waiter --> UC_Pos
  Waiter --> UC_Payment
  KitchenStaff --> UC_Kds

  Customer --> UC_Ordering
  Customer -->|"yêu cầu hóa đơn · thanh toán"| UC_Payment
  Sepay -->|"webhook đối soát"| UC_Payment

  CrossCut -.-> SYS

  classDef actor fill:#fff7ed,stroke:#d97706,color:#111827,stroke-width:1.5px;
  classDef usecase fill:#f0fdf4,stroke:#16a34a,color:#111827,stroke-width:1.5px;
  classDef session fill:#eff6ff,stroke:#2563eb,color:#111827,stroke-width:1.5px;
  classDef external fill:#fdf2f8,stroke:#db2777,color:#111827,stroke-width:1.5px;
  classDef note fill:#f8fafc,stroke:#64748b,color:#334155,stroke-dasharray:4 3;

  class SuperAdmin,Owner,Manager,Waiter,KitchenStaff actor;
  class Customer session;
  class UC_Platform,UC_Catalog,UC_Ordering,UC_Pos,UC_Kds,UC_Payment,UC_Reporting usecase;
  class Sepay external;
  class CrossCut note;
