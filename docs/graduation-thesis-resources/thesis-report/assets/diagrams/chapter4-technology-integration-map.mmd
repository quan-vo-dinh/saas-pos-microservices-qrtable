---
config:
  theme: base
  look: classic
  flowchart:
    htmlLabels: true
    curve: basis
  themeVariables:
    fontFamily: Arial, Helvetica, sans-serif
    primaryTextColor: "#111827"
---
flowchart LR
  %% Render with icon packs:
  %% bash docs/graduation-thesis-resources/thesis-report/tools/render-chapter4-diagrams.sh chapter4-technology-integration-map
  %% Mermaid CLI 11.15+ loads Iconify packs through --iconPacks during render.

  subgraph Platform["Nền tảng phát triển và đóng gói"]
    direction TB
    Nx@{ icon: "logos:nx", form: "rounded", label: "Nx monorepo", pos: "t", h: 58 }
    TS@{ icon: "logos:typescript-icon", form: "rounded", label: "TypeScript contracts", pos: "t", h: 58 }
    Docker@{ icon: "logos:docker-icon", form: "rounded", label: "Docker Compose", pos: "t", h: 58 }
    Observability@{ icon: "logos:grafana", form: "rounded", label: "Grafana stack", pos: "t", h: 58 }
  end

  subgraph Clients["Ứng dụng người dùng"]
    direction TB
    PWA@{ icon: "logos:react", form: "rounded", label: "Customer PWA - React/Vite", pos: "t", h: 58 }
    Management@{ img: "assets/diagrams/icons/nextjs-black.png", label: "Management App - Next.js/React", pos: "t", h: 58, constraint: "on" }
  end

  BFF@{ icon: "logos:nestjs", form: "rounded", label: "BFF/API Gateway - NestJS", pos: "t", h: 62 }

  Services@{ icon: "mdi:server-security", form: "rounded", label: "Domain services - NestJS", pos: "t", h: 62 }

  subgraph Infra["Hạ tầng dữ liệu, cache và sự kiện"]
    direction TB
    Postgres@{ icon: "logos:postgresql", form: "rounded", label: "PostgreSQL - service DB", pos: "t", h: 58 }
    Mongo@{ icon: "logos:mongodb-icon", form: "rounded", label: "MongoDB - User-Access", pos: "t", h: 58 }
    Redis@{ icon: "logos:redis", form: "rounded", label: "Redis - cache/runtime", pos: "t", h: 58 }
    Kafka@{ icon: "logos:kafka-icon", form: "rounded", label: "Kafka - 5 domain topics", pos: "t", h: 58 }
    SocketIO@{ icon: "simple-icons:socketdotio", form: "rounded", label: "Socket.IO - hint/refetch", pos: "t", h: 58 }
  end

  subgraph Providers["Nhà cung cấp ngoài"]
    direction TB
    Keycloak@{ icon: "simple-icons:keycloak", form: "rounded", label: "Keycloak - OIDC/JWT", pos: "t", h: 58 }
    Sepay@{ img: "assets/diagrams/icons/sepay-placeholder.png", label: "SePay/VietQR - QRTBL/QRSUB", pos: "t", h: 58, constraint: "on" }
    Cloudinary@{ icon: "logos:cloudinary-icon", form: "rounded", label: "Cloudinary - menu images", pos: "t", h: 58 }
  end

  Nx -. "quản lý workspace" .-> PWA
  Nx -. "quản lý workspace" .-> Management
  TS -. "shared contracts" .-> BFF
  TS -. "DTO/types dùng chung" .-> Services
  Docker -. "đóng gói demo" .-> BFF
  Docker -. "đóng gói demo" .-> Services
  Observability -. "Prometheus, Loki, Tempo ở mức thiết kế/demo" .-> Kafka

  PWA -- "REST / WebSocket" --> BFF
  Management -- "REST / WebSocket" --> BFF
  BFF -- "TCP/gRPC nội bộ" --> Services

  Services -. "dữ liệu quan hệ có chủ sở hữu" .-> Postgres
  Services -. "profile/RBAC ứng dụng" .-> Mongo
  Services -. "cache / runtime state" .-> Redis
  Services -- "domain events" --> Kafka
  BFF -. "hint/refetch" .-> SocketIO

  Keycloak -- "verify JWT / OIDC" --> BFF
  Sepay -- "webhook qua BFF" --> BFF
  BFF -- "QRTBL/QRSUB route" --> Sepay
  Services -- "ảnh món" --> Cloudinary

  classDef platform fill:#eef2ff,stroke:#4f46e5,stroke-width:1.2px,color:#111827;
  classDef client fill:#eff6ff,stroke:#2563eb,stroke-width:1.3px,color:#111827;
  classDef nextjsClient fill:#eff6ff,stroke:transparent,stroke-width:0,color:#111827;
  classDef edge fill:#fff7ed,stroke:#ea580c,stroke-width:1.5px,color:#111827;
  classDef service fill:#f0fdf4,stroke:#16a34a,stroke-width:1.2px,color:#111827;
  classDef infra fill:#f1f5f9,stroke:#64748b,stroke-width:1.2px,color:#111827;
  classDef external fill:#fdf2f8,stroke:#db2777,stroke-width:1.2px,color:#111827;
  classDef identityProvider fill:#f8fafc,stroke:#4b5563,stroke-width:1.2px,color:#4d4d4d;

  class Nx,TS,Docker,Observability platform;
  class PWA client;
  class Management nextjsClient;
  class BFF edge;
  class Services service;
  class Postgres,Mongo,Redis,Kafka,SocketIO infra;
  class Keycloak identityProvider;
  class Sepay,Cloudinary external;
