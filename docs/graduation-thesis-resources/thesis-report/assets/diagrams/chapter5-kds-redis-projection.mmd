flowchart LR
  Event["order.confirmed<br/>tenantId + orderId + items"] --> Split{"Trạm?"}
  Split -->|KITCHEN| KitchenTicket["ticket hash<br/>kds:{tid}:ticket:{order}:KITCHEN"]
  Split -->|BAR| BarTicket["ticket hash<br/>kds:{tid}:ticket:{order}:BAR"]
  Split -->|missing| Dead["danh sách lỗi (dead-letter)<br/>kds:{tid}:dead-letter:order-confirmed"]

  KitchenTicket --> KItems["set/hash các món của phiếu<br/>ticket:{id}:items<br/>ticket-item:{itemId}"]
  BarTicket --> BItems["set/hash các món của phiếu<br/>ticket:{id}:items<br/>ticket-item:{itemId}"]

  KitchenTicket --> ActiveK["sorted set hoạt động<br/>kds:{tid}:kitchen"]
  BarTicket --> ActiveB["sorted set hoạt động<br/>kds:{tid}:bar"]
  KitchenTicket --> ReadyK["sorted set sẵn sàng<br/>station:KITCHEN:READY"]
  BarTicket --> ReadyB["sorted set sẵn sàng<br/>station:BAR:READY"]

  KitchenTicket --> OrderIndex["set phiếu của đơn<br/>order:{orderId}:tickets"]
  BarTicket --> OrderIndex
  KitchenTicket --> SessionIndex["set phiếu của phiên<br/>session:{sessionId}:tickets"]
  BarTicket --> SessionIndex

  ActiveK --> Revision["phiên bản trạm (revision)<br/>station:{station}:revision"]
  ActiveB --> Revision
  ReadyK --> Revision
  ReadyB --> Revision

  KitchenTicket --> SLA["SLA hash + sorted set hạn chót toàn cục<br/>ticket:{id}:sla / kds:sla:due"]
  BarTicket --> SLA


  classDef event fill:#eef6ff,stroke:#2563eb,color:#0f172a;
  classDef redis fill:#f0fdf4,stroke:#16a34a,color:#14532d;
  classDef warn fill:#fff7ed,stroke:#ea580c,color:#7c2d12;
  class Event event;
  class KitchenTicket,BarTicket,KItems,BItems,ActiveK,ActiveB,ReadyK,ReadyB,OrderIndex,SessionIndex,Revision,SLA redis;
  class Dead warn;
