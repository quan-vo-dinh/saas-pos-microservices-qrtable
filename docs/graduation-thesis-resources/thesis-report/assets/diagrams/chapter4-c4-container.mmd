%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial, sans-serif", "primaryColor": "#f8fafc", "primaryBorderColor": "#334155", "lineColor": "#475569"}}}%%
flowchart TB
  subgraph People["Actors"]
    direction LR
    Customer["Customer<br/>anonymous QR session"]
    Staff["Staff / Chef / Owner<br/>Keycloak JWT"]
    Admin["Super Admin<br/>cross-tenant admin"]
    Provider["SePay provider<br/>bank transfer webhook"]
  end

  subgraph Web["Web containers"]
    direction LR
    CustomerPwa["Customer PWA<br/>React + Vite"]
    ManagementApp["Management App<br/>Next.js"]
  end

  Bff["BFF<br/>API Gateway + WebSocket gateway"]

  subgraph Backend["Backend containers"]
    direction LR
    AuthGroup["Auth boundary<br/>Authorizer + User-Access"]
    OpsGroup["Operations services<br/>SaaS + Catalog + Order"]
    RuntimeGroup["Runtime services<br/>Kitchen + Payment"]
  end

  subgraph Stores["Data and message containers"]
    direction LR
    ServiceDb[("PostgreSQL<br/>per-service schemas")]
    UserMongo[("MongoDB<br/>User-Access")]
    Redis[("Redis<br/>cache/session/cart/KDS")]
    Kafka[("Kafka<br/>domain event stream")]
  end

  subgraph External["External containers"]
    direction LR
    Keycloak["Keycloak<br/>identity provider"]
    Sepay["SePay / VietQR"]
    Cloudinary["Cloudinary"]
  end

  Customer -->|"scan QR, order, track"| CustomerPwa
  Staff -->|"operate POS/KDS/dashboard"| ManagementApp
  Admin -->|"tenant administration"| ManagementApp
  Provider -->|"settlement webhook"| Sepay

  CustomerPwa -->|"HTTPS + Socket.IO"| Bff
  ManagementApp -->|"HTTPS + Socket.IO"| Bff

  Bff -->|"gRPC / TCP"| AuthGroup
  Bff -->|"TCP command/query"| OpsGroup
  Bff -->|"TCP command/query"| RuntimeGroup

  AuthGroup -->|"OIDC / admin API"| Keycloak
  AuthGroup --> UserMongo
  OpsGroup --> ServiceDb
  RuntimeGroup --> ServiceDb

  Bff -->|"edge cache / rooms"| Redis
  OpsGroup -->|"session, cart, tenant cache"| Redis
  RuntimeGroup -->|"KDS queue, OAuth state"| Redis

  OpsGroup -->|"tenant, order, stock events"| Kafka
  RuntimeGroup -->|"payment and KDS events"| Kafka
  Kafka -->|"async fan-out / realtime bridge"| Bff
  Kafka -->|"domain consumers"| OpsGroup
  Kafka -->|"domain consumers"| RuntimeGroup

  Sepay -->|"QRTBL / QRSUB webhook"| Bff
  RuntimeGroup -->|"OAuth / provider API"| Sepay
  OpsGroup -->|"menu images"| Cloudinary

  classDef actor fill:#fef3c7,stroke:#d97706,color:#111827;
  classDef web fill:#dbeafe,stroke:#2563eb,color:#111827;
  classDef edge fill:#fff7ed,stroke:#ea580c,color:#111827;
  classDef backend fill:#dcfce7,stroke:#16a34a,color:#111827;
  classDef store fill:#f1f5f9,stroke:#64748b,color:#111827;
  classDef ext fill:#fae8ff,stroke:#a21caf,color:#111827;

  class Customer,Staff,Admin,Provider actor;
  class CustomerPwa,ManagementApp web;
  class Bff edge;
  class AuthGroup,OpsGroup,RuntimeGroup backend;
  class ServiceDb,UserMongo,Redis,Kafka store;
  class Keycloak,Sepay,Cloudinary ext;
