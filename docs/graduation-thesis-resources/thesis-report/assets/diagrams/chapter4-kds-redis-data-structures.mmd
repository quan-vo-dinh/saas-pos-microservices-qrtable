flowchart LR
  Order["Dịch vụ Order<br/>DB commit + outbox<br/>Kafka: order.confirmed"]
  Kafka@{ icon: "logos:kafka-icon", form: "rounded", label: "Topic Kafka được chấp nhận<br/>order.confirmed", pos: "t", h: 66 }
  Kitchen["Dịch vụ Kitchen<br/>OrderConfirmedConsumer<br/>KdsRedisRepository"]

  TicketHash["Hash<br/>kds:{tid}:ticket:{ticketId}<br/>ticket metadata"]
  ItemHash["Hash<br/>kds:{tid}:ticket-item:{itemId}<br/>item metadata"]
  ItemSet["Set<br/>index ticket/order/session/source-event"]
  ActiveQueue["Sorted Set<br/>kds:{tid}:{station}<br/>hàng đợi FIFO/priority"]
  ReadyQueue["Sorted Set<br/>kds:{tid}:station:{station}:READY<br/>ready/recall queue"]
  SlaQueue["Sorted Set + Hash<br/>kds:sla:due<br/>ticket SLA metadata"]
  Locks["String lock<br/>dedupe event/order/cmd/SLA<br/>rebuild lock"]
  DeadLetter["List<br/>kds:{tid}:dead-letter:order-confirmed"]
  PubSub["Redis Pub/Sub<br/>realtime:kds:{tenantId}<br/>kds.queue_changed hint"]
  BFF["BFF realtime subscriber<br/>kiểm tra payload"]
  WebSocket["Socket.IO rooms<br/>tenant:{tid}:kds:kitchen/bar<br/>tenant:{tid}:management"]

  Order --> Kafka --> Kitchen
  Kitchen --> TicketHash
  Kitchen --> ItemHash
  Kitchen --> ItemSet
  Kitchen --> ActiveQueue
  Kitchen --> ReadyQueue
  Kitchen --> SlaQueue
  Kitchen --> Locks
  Kitchen --> DeadLetter
  Kitchen --> PubSub --> BFF --> WebSocket

  Guardrail["Nguyên tắc kiểm soát<br/>Redis là runtime projection/hint.<br/>Order giữ lịch sử đơn bền vững.<br/>BFF không suy luận trạng thái KDS."]
  Kitchen --> Guardrail
  PubSub --> Guardrail

