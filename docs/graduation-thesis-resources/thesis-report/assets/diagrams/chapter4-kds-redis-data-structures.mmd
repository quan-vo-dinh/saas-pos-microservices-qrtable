flowchart LR
 subgraph RedisStore["Vùng lưu trữ dữ liệu KDS (Redis)"]
        n2["Redis Caching"]
        TicketHash["Hash: kds:{tid}:ticket:{ticketId}<br>ticket metadata"]
        ItemHash["Hash: kds:{tid}:ticket-item:{itemId}<br>item metadata"]
        ItemSet["Set: index ticket/order/session"]
        ActiveQueue["Sorted Set: kds:{tid}:{station}<br>hàng đợi FIFO/priority"]
        ReadyQueue["Sorted Set: kds:{tid}:station:{station}:READY"]
        SlaQueue["Sorted Set + Hash: kds:sla:due<br>SLA metadata"]
        Locks["String lock: dedupe event/order/cmd"]
        DeadLetter["List: dead-letter:order-confirmed"]
  end
    Order["Dịch vụ Order<br>DB commit + outbox<br>Kafka: order.confirmed"] --> n1["Topic Kafka<br>order.confirmed"]
    n1 --> Kitchen["Dịch vụ Kitchen<br>OrderConfirmedConsumer<br>KdsRedisRepository"]
    Kitchen --> TicketHash & ItemHash & ItemSet & ActiveQueue & ReadyQueue & SlaQueue & Locks & DeadLetter & Guardrail["Nguyên tắc kiểm soát<br>• Redis chỉ là runtime projection/hint.<br>• Order giữ lịch sử đơn bền vững.<br>• BFF không tự suy luận trạng thái KDS."]
    TicketHash --> PubSub["Redis Pub/Sub<br>realtime:kds:{tenantId}<br>kds.queue_changed hint"]
    ItemHash --> PubSub
    ItemSet --> PubSub
    ActiveQueue --> PubSub
    ReadyQueue --> PubSub
    SlaQueue --> PubSub
    Locks --> PubSub
    DeadLetter --> PubSub
    PubSub --> BFF["BFF realtime subscriber<br>kiểm tra payload"] & Guardrail
    BFF --> WebSocket["Socket.IO rooms<br>tenant:{tid}:kds:kitchen/bar<br>tenant:{tid}:management"]

