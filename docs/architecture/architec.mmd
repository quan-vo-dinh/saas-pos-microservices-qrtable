flowchart LR
  %% QRTable full system architecture
  %% Solid arrows are implemented runtime communication
  %% Dashed arrows are planned, legacy, or compile-time relationships

  subgraph actors["Actor Layer"]
    customer["Customer<br/>QR guest<br/>Session scoped"]
    staff["Waiter Chef Barista<br/>Tenant staff<br/>JWT role scoped"]
    owner["Owner Manager<br/>Tenant operations<br/>JWT permission scoped"]
    superAdmin["Super Admin<br/>Platform administration"]
    sepayProvider["SePay Banking Network<br/>Payment webhook provider"]
  end

  subgraph clients["Client Application Layer"]
    customerPwa["Customer PWA<br/>React Vite<br/>Scan QR, menu, cart, order, bill"]
    managementApp["Management App<br/>Next.js<br/>POS, KDS, menu, tables, staff, tenant admin"]
    keycloakTheme["Keycloak Theme App<br/>Custom login UI<br/>Deployed into Keycloak"]
  end

  subgraph edge["Edge and API Gateway Layer"]
    bffRest["BFF Service<br/>HTTP 3300<br/>REST api/v1<br/>Swagger api/v1/docs"]
    bffWs["Realtime Gateway<br/>Socket.IO namespace /orders<br/>Customer and staff rooms"]
    guardChain["Global Guard Chain<br/>UserGuard<br/>SessionGuard<br/>TenantGuard<br/>PermissionGuard<br/>ThrottlerGuard"]
    tenantMiddleware["Tenant Middleware<br/>Resolve tenant from header slug or token"]
    realtimeAuth["Realtime Auth<br/>Staff JWT via Authorizer gRPC<br/>Customer session via Redis"]
    redisIoAdapter["Redis Socket Adapter<br/>Multi instance Socket.IO fanout"]
    kafkaBridge["BFF Kafka Bridge<br/>Consumes kitchen.sla_warning<br/>Consumes payment.completed"]
    kdsRedisSub["KDS Redis Subscriber<br/>Subscribes realtime:kds wildcard"]
  end

  subgraph services["Microservice Layer"]
    subgraph identity["Identity and Access Services"]
      authorizer["Authorizer Service<br/>HTTP 3304<br/>TCP 3204<br/>gRPC 5100<br/>JWT verification, Keycloak admin, permission checks"]
      userAccess["User Access Service<br/>HTTP 3303<br/>TCP 3203<br/>gRPC 5200<br/>Users, roles, RBAC permission matrix"]
    end

    subgraph tenantCore["Tenant and Catalog Services"]
      saas["SaaS Service<br/>HTTP 3306<br/>TCP 3206<br/>Tenant, slug, subscription metadata"]
      catalog["Catalog Service<br/>HTTP 3305<br/>TCP 3205<br/>Menu, categories, areas, tables, QR metadata"]
    end

    subgraph orderOps["Ordering, Kitchen, Payment Services"]
      order["Order Service<br/>HTTP 3301<br/>TCP 3201<br/>Session, cart, order, bill, service request, outbox"]
      kitchen["Kitchen Service<br/>HTTP 3307<br/>TCP 3207<br/>KDS tickets, station queues, SLA worker"]
      payment["Payment Service<br/>HTTP 3308<br/>TCP 3208<br/>Bill payment, SePay QR, webhook processing, outbox"]
    end

    subgraph roadmap["Legacy Services"]
      productLegacy["Product Service<br/>HTTP 3302<br/>TCP 3202<br/>Legacy template service"]
    end
  end

  subgraph infra["Data, Messaging, and Provider Layer"]
    postgres["PostgreSQL 5432<br/>Catalog tables<br/>Order sessions orders bills<br/>Payment records audits<br/>SaaS tenants"]
    mongo["MongoDB 27017<br/>Users, roles, permissions"]
    redis["Redis 6379<br/>Session cache, cart state<br/>Rate limit, auth cache<br/>KDS queues, pubsub<br/>Socket.IO adapter"]
    kafka["Kafka KRaft<br/>Internal 9092<br/>Host 29092<br/>order.confirmed<br/>order.status_changed<br/>kitchen.sla_warning<br/>payment.completed<br/>tenant.created"]
    keycloak["Keycloak 8180<br/>Realm qrtable<br/>Client qrtable-bff<br/>OIDC, JWKS, admin API"]
    cloudinary["Cloudinary<br/>Menu image upload and delivery"]
    sepayQr["SePay VietQR<br/>qr.sepay.vn image endpoint"]
    observabilityPlanned["Observability Stack<br/>Planned<br/>Prometheus, Grafana, Loki, Tempo"]
    pgAdmin["pgAdmin 5050<br/>Database administration"]
    redisInsight["RedisInsight 5540<br/>Redis administration"]
  end

  subgraph shared["Nx Monorepo Shared Foundation"]
    sharedLibs["Shared Libraries<br/>Configuration, constants, DTO contracts<br/>Guards, interceptors, middleware<br/>Entities, interfaces, providers"]
  end

  customer -->|"Scans table QR<br/>opens tenant table session"| customerPwa
  staff -->|"Browser login and operations"| managementApp
  owner -->|"Tenant management workflows"| managementApp
  superAdmin -->|"Platform administration"| managementApp

  managementApp -->|"OIDC login redirect"| keycloak
  keycloakTheme -.->|"Custom login templates"| keycloak

  customerPwa -->|"HTTP REST 3300 api/v1<br/>tenant and session headers"| bffRest
  managementApp -->|"HTTP REST 3300 api/v1<br/>Bearer JWT"| bffRest

  customerPwa <-->|"Socket.IO /orders<br/>session handshake"| bffWs
  managementApp <-->|"Socket.IO /orders<br/>JWT handshake"| bffWs

  bffRest -->|"Request pipeline"| tenantMiddleware
  tenantMiddleware -->|"Resolved context"| guardChain
  guardChain -->|"Allowed request"| bffRest

  bffWs -->|"Authenticate websocket connection"| realtimeAuth
  realtimeAuth -->|"Read customer session<br/>cache staff token result"| redis
  realtimeAuth -->|"gRPC 5100 verify staff token"| authorizer
  bffWs -->|"Fanout across BFF instances"| redisIoAdapter
  redisIoAdapter -->|"Socket.IO Redis adapter"| redis

  bffRest -->|"gRPC 5100 JWT verify<br/>permission support"| authorizer
  bffRest -->|"TCP 3204 auth operations"| authorizer
  bffRest -->|"TCP 3203 user, role, staff data"| userAccess
  bffRest -->|"TCP 3206 tenant, slug, current tenant"| saas
  bffRest -->|"TCP 3205 menu, category, table, QR"| catalog
  bffRest -->|"TCP 3201 session, cart, order, bill"| order
  bffRest -->|"TCP 3207 KDS queue and item actions"| kitchen
  bffRest -->|"TCP 3208 payment QR, cash, webhook"| payment
  bffRest -.->|"TCP 3202 legacy product API"| productLegacy

  bffRest -->|"Upload menu image stream"| cloudinary
  bffRest -->|"Rate limit cache<br/>tenant and session cache"| redis

  kafkaBridge -->|"Kafka consumer group bff-kafka-bridge"| kafka
  kafkaBridge -->|"TCP 3201 fetch bill payment snapshot"| order
  kafkaBridge -->|"Emit payment completed<br/>Emit SLA warning"| bffWs

  kdsRedisSub -->|"Redis Pub/Sub realtime:kds wildcard"| redis
  kdsRedisSub -->|"Emit queue changed to station rooms"| bffWs

  bffWs -->|"Customer room<br/>session scoped order, bill, service events"| customerPwa
  bffWs -->|"Staff room<br/>tenant scoped order and service events"| managementApp
  bffWs -->|"KDS station rooms<br/>kitchen and bar queue events"| managementApp
  bffWs -->|"Management room<br/>SLA, payment, dashboard events"| managementApp

  authorizer -->|"JWKS and admin API<br/>HTTP 8180"| keycloak
  authorizer -->|"TCP 3203 profile roles permissions"| userAccess
  authorizer -->|"gRPC 5200 user access lookup"| userAccess
  userAccess -->|"Mongoose collections<br/>users roles permissions"| mongo

  saas -->|"Tenant records<br/>subscription metadata"| postgres
  saas -.->|"Planned tenant.created event"| kafka

  catalog -->|"Menu, category, area, table data"| postgres
  catalog -->|"Stores uploaded image URL"| postgres

  order -->|"Order domain tables<br/>sessions orders items bills service requests outbox"| postgres
  order -->|"Session state, cart state, idempotency"| redis
  order -->|"TCP 3205 validate table<br/>read menu snapshot<br/>update table state"| catalog
  order -->|"Outbox publisher<br/>order.confirmed"| kafka
  kafka -->|"payment.completed<br/>mark bill paid async path"| order

  kafka -->|"order.confirmed"| kitchen
  kitchen -->|"KDS ticket hash and station sorted sets"| redis
  kitchen -->|"Publish realtime:kds queue changed"| redis
  kitchen -->|"TCP 3201 update item status<br/>ready, served, cancelled"| order
  kitchen -->|"Publish kitchen.sla_warning"| kafka

  payment -->|"Payments, audit log, payment outbox"| postgres
  payment -->|"TCP 3201 bill snapshot<br/>BILL_MARK_PAID fast path"| order
  payment -->|"Outbox publisher<br/>payment.completed"| kafka
  payment -.->|"Builds QR URL returned to client"| sepayQr

  customerPwa -->|"Fetch QR image when paying online"| sepayQr
  managementApp -->|"Fetch QR image for POS payment"| sepayQr

  sepayProvider -->|"HTTP webhook with route auth<br/>POST api/v1/payment/sepay/webhook"| bffRest
  bffRest -->|"Forward validated webhook command<br/>TCP 3208"| payment


  productLegacy -.->|"Legacy product data"| postgres

  postgres -.->|"Admin UI"| pgAdmin
  redis -.->|"Admin UI"| redisInsight

  bffRest -.->|"Metrics logs traces planned"| observabilityPlanned
  authorizer -.->|"Metrics logs traces planned"| observabilityPlanned
  userAccess -.->|"Metrics logs traces planned"| observabilityPlanned
  saas -.->|"Metrics logs traces planned"| observabilityPlanned
  catalog -.->|"Metrics logs traces planned"| observabilityPlanned
  order -.->|"Metrics logs traces planned"| observabilityPlanned
  kitchen -.->|"Metrics logs traces planned"| observabilityPlanned
  payment -.->|"Metrics logs traces planned"| observabilityPlanned

  sharedLibs -.->|"Compile time imports"| bffRest
  sharedLibs -.->|"Compile time imports"| authorizer
  sharedLibs -.->|"Compile time imports"| userAccess
  sharedLibs -.->|"Compile time imports"| saas
  sharedLibs -.->|"Compile time imports"| catalog
  sharedLibs -.->|"Compile time imports"| order
  sharedLibs -.->|"Compile time imports"| kitchen
  sharedLibs -.->|"Compile time imports"| payment

  classDef actor fill:#f8f9fa,stroke:#868e96,color:#212529,stroke-width:1px;
  classDef client fill:#e7f5ff,stroke:#1c7ed6,color:#0b3157,stroke-width:1px;
  classDef edge fill:#fff4e6,stroke:#f08c00,color:#4d2b00,stroke-width:1px;
  classDef service fill:#ebfbee,stroke:#2f9e44,color:#123b1c,stroke-width:1px;
  classDef data fill:#f3f0ff,stroke:#7048e8,color:#27154f,stroke-width:1px;
  classDef provider fill:#fff0f6,stroke:#d6336c,color:#5f1230,stroke-width:1px;
  classDef planned fill:#f1f3f5,stroke:#868e96,color:#343a40,stroke-dasharray:5 5;
  classDef shared fill:#e9ecef,stroke:#495057,color:#212529,stroke-width:1px;

  class customer,staff,owner,superAdmin,sepayProvider actor;
  class customerPwa,managementApp,keycloakTheme client;
  class bffRest,bffWs,guardChain,tenantMiddleware,realtimeAuth,redisIoAdapter,kafkaBridge,kdsRedisSub edge;
  class authorizer,userAccess,saas,catalog,order,kitchen,payment service;
  class postgres,mongo,redis,kafka data;
  class keycloak,cloudinary,sepayQr,sepayProvider provider;
  class productLegacy,observabilityPlanned planned;
  class sharedLibs shared;
