# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

.env

# Ignore docker data
docker/**/docker_data/

# Ignore Antigravity agent files
.agent/

# Local agent skill script caches
.agents/**/__pycache__/

vite.config.*.timestamp*

# Local ngrok config (may contain authtoken) — keep example only in git
tools/ngrok/qrtable-dev-ngrok.yml

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# LaTeX build artifacts for the graduation thesis report
docs/graduation-thesis-resources/thesis-report/*.aux
docs/graduation-thesis-resources/thesis-report/*.bbl
docs/graduation-thesis-resources/thesis-report/*.bcf
docs/graduation-thesis-resources/thesis-report/*.blg
docs/graduation-thesis-resources/thesis-report/*-blx.bib
docs/graduation-thesis-resources/thesis-report/*.fdb_latexmk
docs/graduation-thesis-resources/thesis-report/*.fls
docs/graduation-thesis-resources/thesis-report/*.lof
docs/graduation-thesis-resources/thesis-report/*.log
docs/graduation-thesis-resources/thesis-report/*.lot
docs/graduation-thesis-resources/thesis-report/*.out
docs/graduation-thesis-resources/thesis-report/*.pdf
docs/graduation-thesis-resources/thesis-report/*.run.xml
docs/graduation-thesis-resources/thesis-report/*.synctex.gz
docs/graduation-thesis-resources/thesis-report/*.toc
