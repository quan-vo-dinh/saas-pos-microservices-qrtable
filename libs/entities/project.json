{
  "name": "entities",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/entities/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:data-access"],
  "// targets": "to see all targets run: nx show project entities --web",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["constants:build", "shared-types:build"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/entities",
        "main": "libs/entities/src/index.ts",
        "tsConfig": "libs/entities/tsconfig.lib.json"
      }
    },
    "test": {
      "skipTest": true
    }
  }
}
