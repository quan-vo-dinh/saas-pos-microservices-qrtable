{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/libs/entities",
    "declaration": true,
    "types": ["node"],
    "target": "es2021",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@common/constants/*": ["dist/libs/constants/src/lib/*"],
      "@common/configuration/*": ["libs/configuration/src/lib/*"],
      "@common/middlewares/*": ["libs/middlewares/src/lib/*"],
      "@common/utils/*": ["libs/utils/src/lib/*"],
      "@common/interfaces/*": ["libs/interfaces/src/lib/*"],
      "@common/interceptors/*": ["libs/interceptors/src/lib/*"],
      "@common/decorators/*": ["libs/decorators/src/lib/*"],
      "@common/schemas/*": ["libs/schemas/src/lib/*"],
      "@common/entities/*": ["libs/entities/src/lib/*"],
      "@common/guards/*": ["libs/guards/src/lib/*"],
      "@common/error-messages/*": ["libs/error-messages/src/lib/*"],
      "@common/providers/cloudinary/*": ["libs/providers/cloudinary/src/lib/*"],
      "@common/providers/redis-client/*": ["libs/providers/redis-client/src/lib/*"],
      "@einvoice/types": ["dist/libs/shared/types/src/index"],
      "@einvoice/shared-constants": ["libs/shared/constants/src/index.ts"],
      "@einvoice/frontend-ui": ["libs/frontend/ui/src/index.ts"],
      "@einvoice/frontend-hooks": ["libs/frontend/hooks/src/index.ts"],
      "@einvoice/frontend-utils": ["libs/frontend/utils/src/index.ts"],
      "@einvoice/mock-data": ["libs/shared/mock-data/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["jest.config.ts", "jest.config.cts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
