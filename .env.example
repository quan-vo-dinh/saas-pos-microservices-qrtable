# =============================================================================
# Database
# =============================================================================
MONGODB_URI=mongodb://root:password@localhost:27017
MONGO_DB_NAME=qrtable

# =============================================================================
# App-wide
# =============================================================================
NODE_ENV=development
GLOBAL_PREFIX=api/v1

# =============================================================================
# HTTP — listen ports (3300–3308; BFF is generic PORT in apps/bff)
# 3300 BFF | 3301 Order | 3302 Product | 3303 User-Access | 3304 Authorizer
# 3305 Catalog | 3306 SaaS | 3307 Kitchen | 3308 Payment  (TCP: 3201–3208)
# =============================================================================
PORT=3300
ORDER_PORT=3301
PRODUCT_PORT=3302
USER_ACCESS_PORT=3303
AUTHORIZER_PORT=3304
CATALOG_PORT=3305
SAAS_PORT=3306
KITCHEN_PORT=3307
PAYMENT_PORT=3308

# =============================================================================
# HTTP — service hosts (REST / gateway; typical local = localhost)
# Order matches the HTTP ports block above.
# =============================================================================
PRODUCT_SERVICE_HOST=localhost
USER_ACCESS_SERVICE_HOST=localhost
AUTHORIZER_SERVICE_HOST=localhost
CATALOG_SERVICE_HOST=localhost
SAAS_SERVICE_HOST=localhost
ORDER_SERVICE_HOST=localhost
KITCHEN_SERVICE_HOST=localhost
PAYMENT_SERVICE_HOST=localhost

# =============================================================================
# TCP — Nest microservice transport (libs/configuration tcp.config.ts)
# Ports: TCP_*_SERVICE_PORT (defaults 3201–3208 if omitted).
# Hosts: TCP_*_SERVICE_HOST optional; TcpProvider falls back to *_SERVICE_HOST.
# =============================================================================
TCP_ORDER_SERVICE_PORT=3201
TCP_PRODUCT_SERVICE_PORT=3202
TCP_USER_ACCESS_SERVICE_PORT=3203
TCP_AUTHORIZER_SERVICE_PORT=3204
TCP_CATALOG_SERVICE_PORT=3205
TCP_SAAS_SERVICE_PORT=3206
TCP_KITCHEN_SERVICE_PORT=3207
TCP_KITCHEN_SERVICE_HOST=localhost
TCP_PAYMENT_SERVICE_PORT=3208
TCP_PAYMENT_SERVICE_HOST=localhost

# =============================================================================
# Kafka — Order, Kitchen, BFF bridge, Payment
# =============================================================================
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=qrtable-order-service
KAFKA_ORDER_CONFIRMED_TOPIC=order.confirmed
KAFKA_KITCHEN_CLIENT_ID=qrtable-kitchen-service
KAFKA_KITCHEN_CONSUMER_GROUP=kitchen-service-group
KAFKA_BFF_CLIENT_ID=qrtable-bff-bridge
KAFKA_BFF_CONSUMER_GROUP=bff-kafka-bridge
KAFKA_KITCHEN_SLA_WARNING_TOPIC=kitchen.sla_warning
KAFKA_PAYMENT_COMPLETED_TOPIC=payment.completed
KAFKA_PAYMENT_REFUNDED_TOPIC=payment.refunded
KAFKA_PAYMENT_CLIENT_ID=qrtable-payment-service

# =============================================================================
# KDS (Kitchen — Step 2.6)
# =============================================================================
KDS_DEFAULT_SLA_SECONDS=900
KDS_BREACH_GRACE_SECONDS=300
KDS_SLA_WORKER_INTERVAL_MS=5000
KDS_RECALL_WINDOW_SECONDS=300
KDS_READY_RETENTION_SECONDS=3600
KDS_ARCHIVED_TTL_SECONDS=86400

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=1800000

# =============================================================================
# Keycloak
# =============================================================================
KEYCLOAK_HOST=http://localhost:8180
KEYCLOAK_REALM=qrtable
KEYCLOAK_CLIENT_ID=qrtable-bff
KEYCLOAK_CLIENT_SECRET=your_client_secret_here

# =============================================================================
# Auth behavior
# =============================================================================
AUTH_AUTO_PROVISION_ON_FIRST_LOGIN=false

# =============================================================================
# Payment / SePay / Phase 3 (BFF webhook, Playwright: tests/e2e/phase-3-payment.spec.ts)
# =============================================================================
PAYMENT_TYPEORM_DATABASE=qrtable_payment
SEPAY_WEBHOOK_SECRET=
# Platform subscription webhook secret (QRSUB)
SEPAY_PLATFORM_WEBHOOK_SECRET=
BFF_PAYMENT_TCP_TIMEOUT_MS=5000
PAYMENT_SEPAY_QR_ACCOUNT=
PAYMENT_SEPAY_QR_BANK=
PAYMENT_ORDER_TCP_TIMEOUT_MS=5000
PAYMENT_SECRETS_ENCRYPTION_KEY=

# Phase 4B — SePay OAuth Connect (tenant payment settings)
SEPAY_OAUTH_BASE_URL=https://my.sepay.vn
SEPAY_OAUTH_CLIENT_ID=
SEPAY_OAUTH_CLIENT_SECRET=
SEPAY_OAUTH_REDIRECT_URI=https://saas-pos-microservices-qrtable-mana.vercel.app/dashboard/payment-settings/sepay-callback
PUBLIC_API_BASE_URL=
# PHASE3_OWNER_EMAIL=
# PHASE3_OWNER_PASSWORD=

# =============================================================================
# Cloudinary (image uploads)
# =============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
