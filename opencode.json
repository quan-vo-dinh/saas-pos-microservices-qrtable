{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local API",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:LOCAL_API_KEY}",
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "models": {
        "my-combo": {
          "name": "My Combo"
        },
        "cx/gpt-5.5": {
          "name": "GPT-5.5",
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "medium": {
              "reasoningEffort": "medium",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          }
        },
        "cx/gpt-5.5-review": {
          "name": "CX GPT 5.5 Review"
        },
        "cu/claude-4.5-sonnet": {
          "name": "Claude 4.5 Sonnet"
        },
        "cu/default": {
          "name": "CU Default"
        }
      }
    }
  },
  "model": "local/my-combo",
  "small_model": "local/my-combo"
}
