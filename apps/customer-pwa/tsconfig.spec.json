{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["jest", "node", "react", "react-dom", "vite/client"],
    "skipLibCheck": true,
    "allowUmdGlobalAccess": true,
    "jsx": "react-jsx"
  },
  "include": [
    "jest.config.cjs",
    "src/test/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.d.ts"
  ]
}
