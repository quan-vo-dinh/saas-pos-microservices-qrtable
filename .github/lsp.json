{
  "lspServers": {
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "fileExtensions": {
        ".ts": "typescript",
        ".tsx": "typescript"
      },
      "initializationOptions": {
        "preferences": {
          "importModuleSpecifierPreference": "non-relative",
          "includeCompletionsForModuleExports": true,
          "includeCompletionsWithSnippetText": true
        }
      }
    }
  }
}
