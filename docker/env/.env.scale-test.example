# QRTable functional scale-out local experiment.
# Copy to docker/env/.env.scale-test.local and adjust image tag/ports if needed.

SCALE_TEST_IMAGE_REPOSITORY=registry.digitalocean.com/qrtable/qrtable
SCALE_TEST_IMAGE_TAG=v1.0.0

SCALE_TEST_POSTGRES_HOST_PORT=15432
SCALE_TEST_REDIS_HOST_PORT=16379
SCALE_TEST_KAFKA_HOST_PORT=19092
SCALE_TEST_BFF_A_PORT=4300
SCALE_TEST_BFF_B_PORT=4302
SCALE_TEST_ORDER_A_HTTP_PORT=4301
SCALE_TEST_ORDER_A_TCP_PORT=4201
SCALE_TEST_ORDER_B_HTTP_PORT=4311
SCALE_TEST_ORDER_B_TCP_PORT=4211
SCALE_TEST_CATALOG_HTTP_PORT=4305
SCALE_TEST_CATALOG_TCP_PORT=4205
SCALE_TEST_SAAS_HTTP_PORT=4306
SCALE_TEST_SAAS_TCP_PORT=4206

NODE_ENV=development
GLOBAL_PREFIX=api/v1
LOG_LEVEL=warn

POSTGRES_USER=qrtable_app
POSTGRES_PASSWORD=generate_on_server
POSTGRES_DB=qrtable
TYPEORM_USERNAME=qrtable_app
TYPEORM_PASSWORD=generate_on_server
TYPEORM_TYPE=postgres
TYPEORM_SYNCHRONIZE=false
DATABASE_SHARED_FALLBACK_ENABLED=false
CATALOG_TYPEORM_DATABASE=qrtable_catalog
ORDER_TYPEORM_DATABASE=qrtable_order
PAYMENT_TYPEORM_DATABASE=qrtable_payment
SAAS_TYPEORM_DATABASE=qrtable_saas

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=password
USER_ACCESS_MONGO_DB_NAME=qrtable_auth

KEYCLOAK_HOST=http://localhost:8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

REDIS_TTL=1800000
KAFKA_CLUSTER_ID=replace_with_one_stable_kraft_cluster_id
KAFKA_ORDER_CONFIRMED_TOPIC=order.confirmed
KAFKA_ORDER_STATUS_CHANGED_TOPIC=order.status_changed
KAFKA_KITCHEN_SLA_WARNING_TOPIC=kitchen.sla_warning
KAFKA_PAYMENT_COMPLETED_TOPIC=payment.completed
KAFKA_TENANT_CREATED_TOPIC=tenant.created

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4300,http://localhost:4302
